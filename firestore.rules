rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return profileExists() && userProfile().active == true;
    }

    function isMainAdmin() {
      return profileExists()
        && userProfile().active == true
        && userProfile().role == 'mainAdmin';
    }

    function isOfficeAdmin() {
      return profileExists()
        && userProfile().active == true
        && userProfile().role in ['mainAdmin', 'admin', 'coAdmin'];
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isOfficeAdmin());
      allow list: if isOfficeAdmin();

      // A newly authenticated advocate may create only their own inactive,
      // non-privileged registration profile.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'phone', 'role', 'active', 'createdAt'])
        && request.resource.data.role == 'advocate'
        && request.resource.data.active == false
        && request.resource.data.name is string
        && request.resource.data.phone is string;

      // Only the permanent Main Admin may approve, change roles, or reject profiles.
      allow update: if isMainAdmin()
        && (resource.data.role != 'mainAdmin'
            || request.resource.data.role == 'mainAdmin');
      allow delete: if isMainAdmin() && resource.data.role != 'mainAdmin';
    }

    match /tasks/{recordId} {
      allow read: if isOfficeAdmin()
        || (isActiveUser() && resource.data.assigneeUid == request.auth.uid);
      allow create, delete: if isOfficeAdmin();
      allow update: if isOfficeAdmin()
        || (isActiveUser()
          && resource.data.assigneeUid == request.auth.uid
          && request.resource.data.assigneeUid == resource.data.assigneeUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['Pending', 'In progress', 'Completed']);
    }

    match /cases/{recordId} {
      allow read: if isOfficeAdmin()
        || (isActiveUser() && resource.data.advocateUid == request.auth.uid);
      allow create, update, delete: if isOfficeAdmin();
    }

    match /hearings/{recordId} {
      allow read: if isOfficeAdmin()
        || (isActiveUser() && resource.data.advocateUid == request.auth.uid);
      allow create, update, delete: if isOfficeAdmin();
    }

    match /clients/{recordId} {
      allow read, write: if isOfficeAdmin();
    }

    match /entries/{recordId} {
      allow read, write: if isOfficeAdmin();
    }

    // No other collection is accessible by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}